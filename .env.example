# Copy to .env.local for local development, and add the same keys in Vercel.
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public URL of the site, used for Open Graph links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Plans from a TikTok / Reel link. Server-only: never prefix with NEXT_PUBLIC_.
# Claude reads the caption and suggests place, price and day. Without it, a simple keyword guess is used.
ANTHROPIC_API_KEY=
# Contact for OpenStreetMap's geocoder (their usage policy asks for one). Any email you read.
GEOCODER_CONTACT_EMAIL=
